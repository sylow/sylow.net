# Copy to .env for local dev. Nuxt auto-loads .env in `npm run dev`.
# Production URL is the default in nuxt.config.ts — only override here
# when you want to point the dev UI at a non-prod API.

# Sylow forms API endpoint. The local Rails API runs on port 3013.
NUXT_PUBLIC_FORMS_ENDPOINT=http://localhost:3013/api/v1/forms/sylow.net/contact
